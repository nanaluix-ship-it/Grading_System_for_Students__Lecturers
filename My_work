def average_grade_all_lecturers(lecturers, course):
    l_average = 0
    a = 0
    for i in lecturers:
        for j in i.grades:
            if j == course:
                for k in i.grades[j]:
                    l_average += k
                    a += 1
    sum_grade = l_average / a
    return f'Средняя оценка за лекции по курсу {course}: {round(sum_grade,2)}\n'

def average_grade_all_students(students, course):
    s_average = 0
    b = 0
    for i in students:
        for j in i.grades:
            if j == course:
                for k in i.grades[j]:
                    s_average += k
                    b += 1
    sum_grade = s_average / b
    return f'Средняя оценка за домашние задания по курсу {course}: {round(sum_grade, 2)}'

