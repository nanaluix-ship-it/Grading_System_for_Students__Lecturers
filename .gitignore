# Виртуальное окружение — обязательно, чтобы не тащить сотни файлов
venv/
.venv/
env/

# IDE (Giga IDE / PyCharm) — локальные настройки, не нужны в репозитории
.idea/
*.iml
*.ipr
*.iws

# Python кэш и временные файлы
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Артефакты сборки (если позже будешь публиковать на PyPI — они всё равно не в git)
build/
dist/
*.egg-info/

# Кэш pytest (он создаётся при каждом прогоне)
.pytest_cache/

# Локальные конфиги и ОС-мусор
.env
.DS_Store
Thumbs.db
*.tmp
*.temp